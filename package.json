{
  "name": "t-rex-osint",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop OSINT workstation with Electron UI and Go backend",
  "author": "T-REX OSINT",
  "main": "desktop/main.cjs",
  "trex": {
    "updateFeedUrl": "https://github.com/bhvym-sudo/T-REX/releases/latest/download/latest.yml"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "start:backend": "go run ./backend/cmd/trex",
    "start:desktop": "electron .",
    "build:worker": "python -m nuitka --standalone --onefile --windows-console-mode=disable --output-dir=python_worker --output-filename=search.exe --remove-output --include-package=playwright python_worker/search_timeline.py",
    "build:desktop": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.trex.osint",
    "productName": "T-REX OSINT",
    "asar": true,
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/trex-backend.exe",
        "to": "backend/trex-backend.exe"
      },
      {
        "from": "python_worker/search.exe",
        "to": "python_worker/search.exe"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "assets/icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "T-REX-OSINT-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/bhvym-sudo/T-REX/releases/latest/download/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T-REX OSINT"
    }
  }
}
